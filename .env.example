# Hong Kong 1941 Discord bot: copy this file to .env and fill it in. Never commit .env.
# Placeholders only. Blank lines mean "use the default".

# ---------- Discord (Developer Portal -> your application) ----------
DISCORD_TOKEN=paste-your-bot-token-here
# Application ID (General Information page)
DISCORD_CLIENT_ID=000000000000000000
# No server ID: the bot works in every server it's in. Each server sets its staff roles,
# audit channel and verified role with /setup (saved in DATA_DIR/guilds.json).
# Register the slash commands globally on every start
REGISTER_COMMANDS=true
# Optional: one central channel that gets every server's staff actions (on top of each server's /setup audit channel)
AUDIT_CHANNEL_ID=
# Optional: fallback verified role, used only in the server it belongs to. Prefer /setup verified-role.
VERIFIED_ROLE_ID=

# ---------- Roblox Open Cloud ----------
# An API key made just for this bot (Creator Hub -> Open Cloud -> API Keys). See README for the scopes.
# Deliberately not called ROBLOX_OPEN_CLOUD_API_KEY, so a personal key set on the machine is never picked up.
HK_OPEN_CLOUD_KEY=paste-the-bot-open-cloud-key-here
# Hong Kong 1941 (universe / experience ID, not the place ID)
ROBLOX_UNIVERSE_ID=10772680614
ROBLOX_PLACE_ID=77901932829123
PROFILE_STORE=HK1941_Profiles
GLOBAL_STORE=HK1941_Global
# Army rank group (Canada 1940s ranks) and the group whose owner rank counts as tier 5 (HKAdminConfig.OwnerGroup)
ARMY_GROUP_ID=409406376
OWNER_GROUP_ID=668236881
OWNER_RANK=255

# ---------- Bridge to the game (must match roblox/DiscordBridge.server.luau) ----------
BRIDGE_TOPIC=HK1941Discord
BRIDGE_ACK_MAP=HK1941_DiscordBridge
SERVER_MAP=HK1941_Servers
# Wait for a game server to report back (needs the memory-store read scope)
BRIDGE_ACKS=true
BRIDGE_ACK_TIMEOUT_MS=12000
# Servers ignore a message this many seconds after it was sent
BRIDGE_MESSAGE_TTL_SEC=120

# ---------- Staff tiers (same numbers as HKAdmin in game) ----------
# 1 Trial Moderator, 2 Moderator, 3 Senior Moderator, 4 Administrator, 5 Owner.
# Usually leave these empty and use /setup staff-role in each server instead.
# Comma-separated Discord role IDs; they count in whichever server the role is in.
TIER1_ROLE_IDS=
TIER2_ROLE_IDS=
TIER3_ROLE_IDS=
TIER4_ROLE_IDS=
TIER5_ROLE_IDS=
# Discord user IDs that are always tier 5 (put your own here so you can run /setup)
OWNER_DISCORD_IDS=
# Also give tiers from the linked Roblox account's army rank, like HKAdmin does (rank:tier pairs)
TIER_FROM_ROBLOX_RANK=true
ARMY_RANK_TIERS=5:1,9:2,11:3,13:4
# Change a command's tier: "announce:2,event.schedule:3". The game also checks MIN_TIER in the bridge script.
COMMAND_TIERS=

# ---------- Account linking ----------
# blurb = code in the Roblox profile's About section (no third party). Or bloxlink / rover.
LINK_PROVIDER=blurb
BLOXLINK_API_KEY=
ROVER_API_KEY=
LINK_CODE_TTL_MIN=15

# ---------- Other ----------
# Keep in-game events, each server's Events tab and its /setup event-channel calendar in step
EVENT_SYNC=true
# How often to check, in seconds (30 or more)
EVENT_SYNC_SEC=60
# Reminder posted this many minutes before an event starts
EVENT_REMIND_MIN=15
# How long a Discord event is shown as lasting (in-game events have no end time)
EVENT_LENGTH_MIN=120
# /eligible reads at most this many profiles per scan, and caches the result
ELIGIBLE_MAX_PROFILES=300
ELIGIBLE_CACHE_MIN=10
# Where account links are kept (links.json). Back this folder up.
DATA_DIR=./data
LOG_LEVEL=info
# Human-readable logs (for running in a terminal)
LOG_PRETTY=false
